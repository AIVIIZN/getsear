# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis
REDIS_URL=redis://localhost:6379

# Valor PayTech
VALOR_API_KEY=your-valor-api-key
VALOR_MERCHANT_ID=your-merchant-id
VALOR_MOCK=true

# Twilio
TWILIO_ACCOUNT_SID=your-sid
TWILIO_AUTH_TOKEN=your-token
TWILIO_PHONE_NUMBER=+1234567890

# SendGrid
SENDGRID_API_KEY=your-key
SENDGRID_FROM_EMAIL=noreply@getsear.com

# App
NEXT_PUBLIC_APP_URL=https://getsear.com
NODE_ENV=production

# Observability
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05

# Backup and restore
SUPABASE_PRODUCTION_DB_URL=postgres://postgres:password@db.project.supabase.co:5432/postgres
SUPABASE_STAGING_DB_URL=postgres://postgres:password@db.staging-project.supabase.co:5432/postgres
BACKUP_S3_BUCKET=sear-pos-backups
BACKUP_S3_PREFIX=sear-pos/postgres
BACKUP_RETENTION_DAYS=30
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
