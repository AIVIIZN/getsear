# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-string

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis
REDIS_URL=redis://localhost:6379

# Valor PayTech
VALOR_API_KEY=your-valor-api-key
VALOR_APP_ID=your-valor-app-id
VALOR_BASE_URL=https://api.valorpaytech.com
VALOR_MQTT_BROKER=mqtt://broker.valorpaytech.com
VALOR_MOCK=true

# Twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# SendGrid
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@getsear.com

# JWT
JWT_SECRET_KEY=change-me-to-a-random-string
JWT_EXPIRY_HOURS=8

# GCP
GCP_PROJECT_ID=getsear-pos
GCP_REGION=us-central1
